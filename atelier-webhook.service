[Unit]
Description=Atelier GitHub Webhook Listener
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/nrply/app/atelier
ExecStart=/opt/node22/bin/node /home/nrply/app/atelier/webhook.js
# Das Secret gehört NICHT in diese versionierte Datei. Es liegt außerhalb des
# Repositories und wird beim Start geladen. Anlegen mit:
#   install -m 600 /dev/null /etc/atelier/webhook.env
#   echo "WEBHOOK_SECRET=$(openssl rand -hex 32)" > /etc/atelier/webhook.env
# Denselben Wert im GitHub-Webhook hinterlegen.
EnvironmentFile=/etc/atelier/webhook.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
